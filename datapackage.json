{
  "name": "injury-settlement-value-base",
  "title": "Injury Settlement Value Base",
  "version": "2026.11.24.2",
  "created": "2026-11-24",
  "description": "Summary statistics for 30,827 paid personal injury claims against US government bodies, in 87 segments. Property damage and non-accident claim types are excluded.",
