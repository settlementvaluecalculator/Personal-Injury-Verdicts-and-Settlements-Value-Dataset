    }
  ],
  "sources": [
    {
      "title": "NYC Comptroller, Claims Report - Underlying Settlements and Claims Filed Data",
      "path": "https://data.cityofnewyork.us/d/ex6k-ym48"
    },
    {
      "title": "US Treasury, Judgment Fund: Annual Report to Congress",
      "path": "https://fiscaldata.treasury.gov/datasets/judgment-fund-report-to-congress/"
    },
    {
      "title": "City of Chicago Department of Law, Judgment and Settlement Payment Requests",
